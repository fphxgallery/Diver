# Solana RPC (use a private RPC for production)
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_WS_URL=wss://api.mainnet-beta.solana.com

# Redis (optional — for position state caching and rebalance job queue)
REDIS_URL=redis://redis:6379

# Server monitor PIN — protects /api/unlock, /api/lock, /api/monitor
# Leave empty to disable auth (dev only). Set a strong random string in production.
DIVER_PIN=

# Expose PIN to browser so the client can auth against the API
# Must match DIVER_PIN exactly
NEXT_PUBLIC_DIVER_PIN=

# Server monitor key TTL in hours (default: 8)
DIVER_KEY_TTL_HOURS=8
